<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AQCEstimation</RootNamespace>
    <AssemblyName>AQC-Estimation</AssemblyName>
    <Product>AQC Estimation</Product>
    <Version>0.1.0</Version>
    <!-- S9: distinct installer identity — do not share with BBS / PM -->
    <ApplicationId>in.aorms.aqc.estimation</ApplicationId>
    <ApplicationTitle>AQC Estimation</ApplicationTitle>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pin HolagundiWorks/AQC Aorms.Bridge via submodule path when present -->
    <ProjectReference Include="..\vendor\AQC\BBSDesktop\Aorms.Bridge\Aorms.Bridge.csproj" Condition="Exists('..\vendor\AQC\BBSDesktop\Aorms.Bridge\Aorms.Bridge.csproj')" />
  </ItemGroup>
</Project>
